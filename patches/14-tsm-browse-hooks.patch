-- LOCAL FIX: lets the TSMBrowse overlay (LocalMods) add filter words, applied to each auction result
private.localFilters = {}
function TSMLocalAddItemFilter(key, evalFunc)
	ItemFilter.AddKeyMatchPart(key, evalFunc)
	private.localFilters[key] = function(_, row)
		return not evalFunc(row:GetBaseItemString())
	end
end
