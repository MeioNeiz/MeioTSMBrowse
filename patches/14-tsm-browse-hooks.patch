=== FILE TradeSkillMaster\App\AuctionUI\Shopping.lua
--- OLD
function private.IsPlayer(character, includeAlts)
--- NEW
-- LOCAL FIX: hook points for the TSMBrowse overlay (LocalMods)
local LocalItemClass = App:From("LibTSMWoW"):Include("Util.ItemClass")
TSMLocalShopping = {
	callbacks = {},
	Search = function(filter)
		if not private.localFrame then
			return false
		end
		private.manager:ProcessAction("ACTION_START_FILTER_SEARCH", filter)
		return true
	end,
	GetWindow = function()
		local base = private.localFrame and private.localFrame:GetBaseElement()
		return base and base:_GetBaseFrame()
	end,
	GetClasses = function() return LocalItemClass.GetClasses() end,
	GetSubClasses = function(class) return LocalItemClass.GetSubClasses(class) end,
	GetGenericSlots = function(class)
		local result = {}
		for _, slot in LocalItemClass.GenericInventorySlotStringIterator(class) do
			tinsert(result, slot)
		end
		return result
	end,
	GetSlots = function(class, subClass) return LocalItemClass.GetInventorySlots(class, subClass) end,
}

function private.LocalNotify(frame)
	private.localFrame = frame
	for _, func in ipairs(TSMLocalShopping.callbacks) do
		func(frame ~= nil)
	end
end

